<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onMoved",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "let layoutmanager = TcHmi.Controls.get(\"TcHmiCncLayoutManager_1\");",
          "let availableWidth = layoutmanager.__element[0].parentElement.offsetWidth - 15",
          "let layColumns = layoutmanager.getColumnNumber();",
          "",
          "if(availableWidth/(layColumns + 1) >= 53 || availableWidth/layColumns < 53){",
          "    ",
          "    // While loops to determin the ColumnNumber",
          "    while((availableWidth/(layColumns + 1)) >= 53){",
          "\t\tlayoutmanager.setColumnNumber(layColumns + 1);",
          "    \tlayColumns = layoutmanager.getColumnNumber();",
          "\t} ",
          "\twhile((availableWidth/layColumns) < 53){",
          "\t\tlayoutmanager.setColumnNumber(layColumns - 1);",
          "    \tlayColumns = layoutmanager.getColumnNumber();",
          "\t}    ",
          "    ",
          "    layoutmanager.setWidth(layColumns * 55);",
          "    let layHeight = layoutmanager.getRenderedHeight();",
          "    let layWidth = layoutmanager.getRenderedWidth();",
          "    ",
          "\t// Determin the RowHeight",
          "\tlet gridGap = layoutmanager.getElement().find('.tchmi-layout-manager-grid')[0].style.gridGap.replace('px', '');;",
          "\t// Determin the widht of each element, to get a standard rowHeight",
          "\tlet buff1 = gridGap*(layColumns)",
          "\tlet buff2 = layWidth - buff1",
          "\tlet rowHeight = (buff2/layColumns);",
          "\t// We want any multiple of rowHeight to equal the height of the layoutmanager",
          "\t// See how many rows fit into the current height (this could be a decimal)",
          "\tlet rowCount = layHeight/rowHeight;",
          "\t// the first calculation hadn't taken in account the gaps which should be done in some way.",
          "\trowCount = (layHeight-(gridGap*rowCount))/rowHeight",
          "\t// Make sure that this is not a decimal",
          "\trowCount = Math.ceil(rowCount);",
          "\t// What ever rowCount is now, it should fit perfectly into the height of the layoutmanager",
          "\tlayoutmanager.setCustomRowHeight((layHeight-(gridGap*(rowCount+1)))/rowCount);",
          "}"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  },
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onResized",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "let layoutmanager = TcHmi.Controls.get(\"TcHmiCncLayoutManager_1\");",
          "let availableWidth = layoutmanager.__element[0].parentElement.offsetWidth - 15",
          "let layColumns = layoutmanager.getColumnNumber();",
          "",
          "if(availableWidth/(layColumns + 1) >= 53 || availableWidth/layColumns < 53){",
          "    ",
          "    // While loops to determin the ColumnNumber",
          "    while((availableWidth/(layColumns + 1)) >= 53){",
          "\t\tlayoutmanager.setColumnNumber(layColumns + 1);",
          "    \tlayColumns = layoutmanager.getColumnNumber();",
          "\t} ",
          "\twhile((availableWidth/layColumns) < 53){",
          "\t\tlayoutmanager.setColumnNumber(layColumns - 1);",
          "    \tlayColumns = layoutmanager.getColumnNumber();",
          "\t}    ",
          "    ",
          "    layoutmanager.setWidth(layColumns * 55);",
          "    let layHeight = layoutmanager.getRenderedHeight();",
          "    let layWidth = layoutmanager.getRenderedWidth();",
          "    ",
          "\t// Determin the RowHeight",
          "\tlet gridGap = layoutmanager.getElement().find('.tchmi-layout-manager-grid')[0].style.gridGap.replace('px', '');;",
          "\t// Determin the widht of each element, to get a standard rowHeight",
          "\tlet buff1 = gridGap*(layColumns)",
          "\tlet buff2 = layWidth - buff1",
          "\tlet rowHeight = (buff2/layColumns);",
          "\t// We want any multiple of rowHeight to equal the height of the layoutmanager",
          "\t// See how many rows fit into the current height (this could be a decimal)",
          "\tlet rowCount = layHeight/rowHeight;",
          "\t// the first calculation hadn't taken in account the gaps which should be done in some way.",
          "\trowCount = (layHeight-(gridGap*rowCount))/rowHeight",
          "\t// Make sure that this is not a decimal",
          "\trowCount = Math.ceil(rowCount);",
          "\t// What ever rowCount is now, it should fit perfectly into the height of the layoutmanager",
          "\tlayoutmanager.setCustomRowHeight((layHeight-(gridGap*(rowCount+1)))/rowCount);",
          "}"
        ],
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>
</div>
</div>