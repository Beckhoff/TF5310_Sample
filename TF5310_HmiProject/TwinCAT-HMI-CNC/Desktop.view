        <div id="TcHmiCncMessageLine_1" data-tchmi-type="TcHmi.Controls.TcHmiCncBase.TcHmiCncMessageLine" data-tchmicnc-showsource="true" data-tchmicnc-intervall="1500" data-tchmicnc-showonlymaxseverity="true" data-tchmi-min-width="400" data-tchmi-left="10" data-tchmi-top="20" data-tchmi-right="10" data-tchmi-bottom="20">
            <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
                [
                              {
                                "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onMouseDoubleClick",
                                "actions": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctrl%Region_Center::TargetContent%/ctrl%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/ContentPath",
                                      "value": "Pages/CNCEvents.content"
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              }
                            ]</script>
        </div>
        <div id="TcHmiAdsState_TcSysService" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiAdsState" data-tchmi-ads-runtime="TcSysService" data-tchmi-grid-column-index="1" data-tchmi-grid-row-index="0" data-tchmi-left="10" data-tchmi-left-unit="px" data-tchmi-server-interval="500" data-tchmi-top="20" data-tchmi-top-unit="px" data-tchmi-width-unit="px" data-tchmi-height-unit="px" data-tchmi-width-mode="Value" data-tchmi-max-height-unit="px" data-tchmi-max-width-unit="px" data-tchmi-width="50" data-tchmi-height="50" data-tchmi-bottom-unit="px" data-tchmi-right-unit="px">
            <script data-tchmi-target-attribute="data-tchmi-state-images" type="application/json">
                {
                  "Config": "Images/TwinCAT/twincat-config.svg",
                  "Exception": "Images/TwinCAT/twincat-exeption.svg",
                  "Fallback": "Images/TwinCAT/twincat-fallback.svg",
