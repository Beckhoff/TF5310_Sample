        <div id="Region_Center" data-tchmi-type="TcHmi.Controls.TcHmiCncBase.TcHmiCncDetachableTabNavigation" data-tchmi-left="0" data-tchmi-left-unit="px" data-tchmi-tab-alignment="Left" data-tchmi-bottom="2" data-tchmi-styling="IndicatorLine" data-tchmi-right="5" data-tchmi-top="-2">
            <script data-tchmi-target-attribute="data-tchmi-tabs" type="application/json">
[
  {
    "displayName": "%f%GetLocalizedTextCnc('TcHmiCncMain-CNCMain', 'CNC Main')%/f%",
    "icon": {
      "iconPath": "Images/home.svg",
      "scaleHeight": 1.3,
      "scaleWidth": 1.3
    },
    "targetContent": "Pages/CNCMain.content"
  },
  {
    "displayName": "%f%GetLocalizedTextCnc('TcHmiCncMain-CNCEvents', 'CNC Events')%/f%",
