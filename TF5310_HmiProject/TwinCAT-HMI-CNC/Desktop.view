      "scaleHeight": 1.3,
      "scaleWidth": 1.3
    },
    "targetContent": "Pages/CNCEvents.content"
  },
  {
    "displayName": "%f%GetLocalizedTextCnc('TcHmiCncMain-Diagnosis', 'Diagnosis')%/f%",
    "icon": {
      "iconPath": "Images/diagnosis.svg",
      "scaleHeight": 1.3,
      "scaleWidth": 1.3
    },
    "targetContent": "Pages/Diagnosis.content"
  },
  {
