<div id="Desktop" data-tchmi-type="TcHmi.Controls.System.TcHmiView" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width-unit="%" data-tchmi-width="100" data-tchmi-height-unit="%" data-tchmi-height="100" data-tchmi-background-image-width-unit="%" data-tchmi-background-image-height-unit="%" data-tchmi-background-image-width="100" data-tchmi-background-image-height="100" data-tchmi-creator-viewport-width="1400" data-tchmi-creator-viewport-height="1024">

    <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
        [
          {
            "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onResized",
            "actions": [
              {
                "objectType": "JavaScript",
                "active": true,
                "sourceLines": [
                  "TcHmi.EventProvider.raise(\"Navigation_Left.onResized\");"
                ],
                "asyncWait": true,
                "waitMode": "Synchronous"
              }
            ]
          }
        ]
    </script>
