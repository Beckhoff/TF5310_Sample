            </script>
        </div>
        <div id="TcHmiAdsState_PLC1" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiAdsState" data-tchmi-ads-runtime="PLC1" data-tchmi-grid-column-index="2" data-tchmi-grid-row-index="0" data-tchmi-left="10" data-tchmi-left-unit="px" data-tchmi-server-interval="500" data-tchmi-top="20" data-tchmi-top-unit="px" data-tchmi-width="50" data-tchmi-height="50" data-tchmi-right-unit="px" data-tchmi-bottom-unit="px">
